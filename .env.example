# Copy to .env and fill in. .env is gitignored -- never commit real secrets.

# Which email provider to use: sendgrid | postmark | gmail
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=jobsearch-agent@example.com
EMAIL_TO=yeakel.abby@gmail.com

# SendGrid (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# Postmark (if EMAIL_PROVIDER=postmark)
POSTMARK_SERVER_TOKEN=

# Gmail (if EMAIL_PROVIDER=gmail): no token here -- see
# job_search_agent/email_delivery/gmail_sender.py for the one-time OAuth setup
# (config/gmail_credentials.json + config/gmail_token.json).
